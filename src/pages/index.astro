---
import Layout from '../layouts/Layout.astro';
import SystemStatus from '../components/SystemStatus.astro';
import WhiteGloveCursor from '../components/WhiteGloveCursor.astro';
import noticeImages from '../data/noticeImages.json';
---

<Layout title="Face Exchange">
  <main class="exchange-space" data-app data-view="corridor" data-entrance="outside">
    <SystemStatus />
    <WhiteGloveCursor />
    <svg aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden"><defs>
      <symbol id="guide-sound" viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4zM16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/></symbol>
      <symbol id="guide-language" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><ellipse cx="12" cy="12" rx="3.5" ry="8"/><path d="M4 12h16M6 7.5h12M6 16.5h12"/></symbol>
      <symbol id="guide-fullscreen" viewBox="0 0 24 24"><path d="M9 4H4v5M15 4h5v5M4 15v5h5M20 15v5h-5M7 9V7h2M15 7h2v2M7 15v2h2M17 15v2h-2"/></symbol>
      <symbol id="guide-work" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="1"/><path d="M12 17v4M8 21h8"/></symbol>
      <symbol id="guide-return" viewBox="0 0 24 24"><path d="M9 7l-5 5 5 5M4 12h13a3 3 0 0 1 3 3v3"/></symbol>
    </defs></svg>
    <div class="hall-introduction" aria-label="Facial Auction Hall"><span>Facial Auction</span><span>Hall</span></div>
    <div class="audio-controls" data-audio-controls aria-label="Sound controls">
      <button class="audio-note" type="button" data-audio-menu aria-label="Open sound controls" aria-expanded="false" aria-controls="sound-panel" title="Sound controls">
        <svg class="guide-icon" aria-hidden="true"><use href="#guide-sound"/></svg>
        <span class="audio-note__state" aria-hidden="true"></span>
      </button>
      <button class="language-toggle" type="button" data-language-toggle aria-label="Switch to Chinese" title="Switch to Chinese"><svg class="guide-icon" aria-hidden="true"><use href="#guide-language"/></svg><span data-language-label>中文</span></button>
      <div class="audio-panel" id="sound-panel" data-audio-panel hidden>
        <button type="button" data-sound-toggle aria-label="Enable sound" aria-pressed="false"><span data-sound-label>ENABLE SOUND</span></button>
        <label for="scene-volume">VOLUME</label>
        <input id="scene-volume" data-sound-volume type="range" min="0" max="100" value="35" aria-label="Sound volume" />
        <span class="audio-status" data-sound-status role="status"></span>
      </div>
    </div>
    <button class="fullscreen-toggle" type="button" data-fullscreen-toggle aria-label="Enter full screen" aria-pressed="false" title="Enter full screen" hidden>
      <svg class="guide-icon" aria-hidden="true"><use href="#guide-fullscreen"/></svg>
      <span data-fullscreen-label>FULL SCREEN</span>
    </button>
    <aside class="face-inspector" data-face-inspector role="dialog" aria-label="Archived face and sale price" hidden>
      <button type="button" data-face-inspector-close aria-label="Close face detail">×</button>
      <img alt="Selected archived face variation" width="320" height="400" />
      <p data-face-price></p><p data-face-source></p><p data-face-date></p>
    </aside>
    <section class="final-reflection" data-final-reflection aria-label="After the sale">
      <div class="final-reflection__copy">
        <p class="final-reflection__eyebrow">AFTER THE SALE</p>
        <h1>How would you know?</h1>
        <p>When you upload your portrait and sign a contract to sell it, you know what you’re handing over. You can’t know where it will end up, who will use it next, or what they’ll do with it.</p>
        <p>Would someone buy your face? They could use it for anything, and you might never know.</p>
        <button type="button" data-final-return>Return to the hall</button>
      </div>
    </section>
    <aside class="auction-completion-guide" data-auction-guide role="status" aria-live="polite" hidden>
      <p class="auction-completion-guide__title">Congratulations, dear guest!</p>
      <p>The bidding is over. Your face has been sold. Congratulations!</p>
      <button type="button" data-auction-next disabled>View your sale record <span aria-hidden="true">→</span></button>
    </aside>
    <aside class="journey-next" data-journey-next hidden>
      <p data-journey-note></p><button type="button" data-journey-button></button>
    </aside>
    <aside class="spatial-room-hud" data-spatial-hud aria-label="Room navigation" hidden>
      <div class="spatial-room-hud__heading">
        <p data-spatial-room-number hidden>FACE EXCHANGE</p>
        <h2 data-spatial-room-title hidden></h2>
        <p data-spatial-room-description hidden></p>
      </div>
      <div class="spatial-room-hud__actions">
        <button type="button" data-room-exhibit hidden>ACTIVATE THE ARTWORK</button>
        <button type="button" data-return-corridor><svg class="guide-icon" aria-hidden="true"><use href="#guide-return"/></svg>RETURN TO GALLERY</button>
      </div>
      <p class="spatial-room-hud__hint" data-room-feedback aria-live="polite">W / S to walk · A / D to step sideways · arrows to look · Esc to return</p>
    </aside>

    <section class="corridor-hub" data-corridor aria-labelledby="corridor-title">
      <div class="corridor-shell" aria-hidden="true">
        <div class="corridor-plane corridor-plane--left"></div>
        <div class="corridor-plane corridor-plane--right"></div>
        <div class="corridor-plane corridor-plane--ceiling"></div>
        <div class="corridor-plane corridor-plane--floor"></div>
        <div class="vanishing-lines"></div>
      </div>

      <h1 id="corridor-title" class="corridor-title-accessible">FACE EXCHANGE</h1>

      <dialog class="wall-research-dialog report-cabinet" data-wall-research-dialog aria-labelledby="wall-research-title" data-i18n-ignore>
        <button type="button" data-wall-research-close autofocus><span class="research-en">Close</span><span class="research-zh">关闭</span> ×</button>
        <h2 id="wall-research-title"><span class="research-en">Notice Board</span><span class="research-zh">公告栏</span></h2>
        <div class="cabinet-reports" data-report-selection>
          {noticeImages.map((item,index)=>(
            <button type="button" class="pinned-report pinned-report--image" data-report-select={item.id} aria-label={item.title} style={`--paper-rotation:${[-2,1.5,1,-1.5][index]}deg`}>
              <span class="paper-pin" aria-hidden="true"></span>
              <span class={`notice-artwork notice-artwork--${index+1}`}><img class="notice-thumbnail" src={item.preview||item.image} alt={item.title} /></span>
            </button>
          ))}
        </div>
        <button type="button" class="report-scroll-guide" data-report-scroll hidden aria-label="向下阅读 / Scroll down" aria-controls="notice-report-reader">
          <span aria-hidden="true">↓</span>
        </button>
        <section id="notice-report-reader" class="report-reader" data-report-reader hidden aria-label="Selected research report">
          <button type="button" data-report-back><span class="research-en">← Back to reports</span><span class="research-zh">← 返回报告板</span></button>
          {noticeImages.map((item,index)=>(
            <article data-report-article={item.id} hidden tabindex="-1">
              <div class={`notice-full-artwork${index===3?" notice-full-artwork--trimmed":""}`}><img class="notice-full-image" src={item.image} alt={item.title} loading="lazy" /></div>
              <footer class="clipping-source">
                <p><span class="research-en">Project newspaper adaptation. The source reporting is real; the newspaper design is made for Face Exchange.</span><span class="research-zh">本项目改编的小报。来源报道真实，报纸版式由 Face Exchange 制作。</span></p>
                <p>{item.source.publisher} · {item.source.author} · <time datetime={item.source.date}>{item.source.date}</time>{item.source.status==='credit-only' && <><span class="research-en"> · Date credited on artwork, awaiting verification</span><span class="research-zh"> · 图稿标注日期，待核实</span></>}</p>
                <p><span class="research-en">{item.source.noteEn}</span><span class="research-zh">{item.source.noteZh}</span></p>
                <a href={item.source.url} target="_blank" rel="noopener noreferrer"><span class="research-en">{item.source.status==='checked'?'Read the source':'View Abion’s article announcement'} ↗</span><span class="research-zh">{item.source.status==='checked'?'阅读来源原文':'查看 Abion 官方文章介绍'} ↗</span></a>
                {item.source.related && <a href={item.source.related} target="_blank" rel="noopener noreferrer"><span class="research-en">Related analysis: Hamlins ↗</span><span class="research-zh">相关阅读：Hamlins ↗</span></a>}
              </footer>
            </article>
          ))}
        </section>
      </dialog>
      <div class="three-corridor" data-three-corridor aria-label="Interactive 3D Face Exchange corridor" tabindex="0"></div>

      <div class="fallback-corridor" data-fallback-corridor aria-label="Simplified Face Exchange corridor" hidden>
        <div class="fallback-door-track">
          <button class="corridor-door" type="button" data-fallback-door data-station="0" data-door="enterRoom" style="--station-index: 0;">
            <strong>Introduction</strong><small>enter the market</small>
          </button>
          <button class="corridor-door" type="button" data-fallback-door data-station="1" data-door="submitRoom" style="--station-index: 1;">
            <strong>Inspection Room</strong><small>submit likeness</small>
          </button>
          <button class="corridor-door" type="button" data-fallback-door data-station="2" data-door="classifyRoom" style="--station-index: 2;">
            <strong>Face Swap Room</strong><small>face to asset</small>
          </button>
          <button class="corridor-door" type="button" data-fallback-door data-station="3" data-door="valueRoom" style="--station-index: 3;">
            <strong>Valuation Room</strong><small>fictional value</small>
          </button>
          <button class="corridor-door" type="button" data-fallback-door data-station="4" data-door="termsRoom" style="--station-index: 4;">
            <strong>Auction Hall</strong><small>licence terms</small>
          </button>
          <button class="corridor-door" type="button" data-fallback-door data-station="5" data-door="soldRoom" style="--station-index: 5;">
            <strong>Sale</strong><small>sale record</small>
          </button>
          <button class="corridor-door" type="button" data-fallback-door data-station="6" data-door="auctionRoom" style="--station-index: 6;">
            <strong>Honour</strong><small>transformed likenesses</small>
          </button>
          <button class="corridor-door" type="button" data-fallback-door data-station="7" data-door="reflectRoom" aria-label="Reflection" style="--station-index: 7;"></button>
          <button class="corridor-door" type="button" data-fallback-door data-station="8" data-door="afterlifeRoom" disabled aria-label="Unmarked doorway" style="--station-index: 8;"></button>
        </div>
      </div>

      <div class="corridor-hints" aria-label="Corridor movement hints">
        <p class="station-readout" id="station-readout" aria-live="polite">01 INTRO</p>
        <p data-entrance-instruction>SCROLL / W TO APPROACH</p>
        <p data-gate-instruction>CLICK GATE TO ENTER</p>
        <p data-corridor-instruction>SCROLL / W / S TO MOVE</p>
        <p data-node-instruction>CLICK NEARBY FACE NODE TO ENTER</p>
        <button class="entrance-action" type="button" data-enter-entrance>ENTER THE MARKET</button>
        <details class="accessible-nav">
          <summary>Keyboard navigation</summary>
          <div class="accessible-nav__controls">
            <button class="secondary-action" type="button" data-prev-door>PREVIOUS NODE</button>
            <button class="primary-action" type="button" data-enter-active>ENTER NEARBY NODE</button>
            <button class="secondary-action" type="button" data-next-door>NEXT NODE</button>
            <button type="button" data-open-exhibit="research">Read the notice board</button>
            <button type="button" data-open-exhibit="portrait">View a role portrait</button>
            <button type="button" data-open-exhibit="catalogue">View the catalogue</button>
            <button type="button" data-open-exhibit="video">Watch the video</button>
            <button class="secondary-action" type="button" data-pause-corridor-particles aria-pressed="false">PAUSE AIR PARTICLES</button>
          </div>
        </details>
      </div>
    </section>

    <div class="room-layer" aria-live="polite">
      <section class="room-scene room-scene--enter" data-room="enterRoom" aria-labelledby="enter-title" tabindex="-1">
        <div class="room-frame">
          <p class="terminal-label">FACE EXCHANGE · A PRIVATE INVITATION</p>
          <div class="invitation-seal" aria-hidden="true">FX</div>
          <h2 id="enter-title">The art of<br /><em>being valued.</em></h2>
          <p class="stage-copy">Follow a simulated likeness licence through an auction.</p>
          <ol class="invitation-guide">
            <li><span>I</span><div><strong>Offer your likeness</strong><p>Use your camera or choose a portrait. Images are saved to this project’s local archive.</p></div></li>
            <li><span>II</span><div><strong>Discover its market life</strong><p>Choose a style, explore its fictional value, and follow it through the auction.</p></div></li>
            <li><span>III</span><div><strong>Move at your own pace</strong><p>Scroll or use W / S in the gallery. Move your pointer to look around; select a nearby room to enter.</p></div></li>
          </ol>
          <p class="invitation-note">An artistic simulation. No real sale or payment. Camera tracking is used for the live portrait effect.</p>
          <div class="room-actions">
            <button class="secondary-action" type="button" data-return-corridor>EXPLORE THE GALLERY</button>
            <button class="primary-action" type="button" data-continue="submitRoom">BEGIN THE EXCHANGE</button>
          </div>
        </div>
      </section>

      <section class="room-scene room-scene--submit" data-room="submitRoom" aria-labelledby="submit-title" tabindex="-1">
        <div class="room-frame room-frame--wide">
          <p class="terminal-label">Inspection Room</p>
          <h2 id="submit-title">Upload Your Face Here</h2>
          
          <div class="capture-grid">
            <div class="camera-panel">
              <video id="camera-video" class="camera-video" playsinline muted hidden></video>
              <canvas id="capture-canvas" hidden></canvas>
              <div class="preview-frame" id="empty-preview"><span>LOCAL FACE PREVIEW WAITING</span></div>
              <img id="face-preview" class="face-preview" alt="Submitted face preview" hidden />
            </div>
            <div class="control-stack">
              <button class="secondary-action" type="button" id="start-camera">USE CAMERA</button>
              <button class="secondary-action" type="button" id="take-photo" hidden>TAKE STILL IMAGE</button>
              <button class="upload-label" type="button" id="upload-image-button">UPLOAD IMAGE</button>
              <input id="image-upload" type="file" accept="image/*" hidden />
              <p class="microcopy" id="camera-message" aria-live="polite">Dear guest, please upload your own face and await our appraisal.</p>
              <p class="microcopy microcopy--market">Choose a portrait you have permission to use.</p>
            </div>
          </div>
          <div class="room-actions">
            <button class="primary-action" type="button" data-return-corridor>RETURN TO CORRIDOR</button>
          </div>
        </div>
      </section>

      <section class="room-scene room-scene--classify" data-room="classifyRoom" aria-labelledby="classify-title" tabindex="-1">
        <div class="room-frame room-frame--wide">
          <p class="terminal-label">Portrait Processing Room</p>
          <h2 id="classify-title">What can your face become?</h2>
          <div data-face-reuse></div>
          <details class="previous-portrait-styles" hidden><summary>Previous portrait treatments</summary>
          <div class="package-layout ai-generator-layout">
            <div class="scan-card generator-preview-card">
              <img id="package-preview" class="face-preview generated-source-preview" alt="Submitted face with simulated generator overlay" hidden />
              <div class="preview-frame" id="generator-placeholder"><span>LOCAL FACE PRODUCT INPUT</span></div>
              <div class="scan-overlay" aria-hidden="true"></div>
              <div class="metadata-tags" id="metadata-tags"></div>
              <div class="generator-status" id="generator-status" aria-live="polite">SELECT A STYLE TO GENERATE</div>
            </div>
            <fieldset class="mode-fieldset">
              <legend>Choose a portrait style</legend>
              <label class="mode-card generator-style-card"><input type="radio" name="package-mode" value="jobInterview" /> <span>01 / Staff</span><strong>Staff</strong><small>A work uniform, shirt collar and staff badge.</small></label>
              <label class="mode-card generator-style-card"><input type="radio" name="package-mode" value="luxury" /> <span>02 / Artist</span><strong>Artist</strong><small>Long hair, an artist’s smock and paintbrushes.</small></label>
              <label class="mode-card generator-style-card"><input type="radio" name="package-mode" value="influencer" /> <span>03 / Singer</span><strong>Singer</strong><small>A stage jacket and a handheld microphone.</small></label>
              <label class="mode-card generator-style-card"><input type="radio" name="package-mode" value="passport" /> <span>04 / Designer</span><strong>Designer</strong><small>A dark turtleneck, glasses and a sketchbook.</small></label>
            </fieldset>
          </div>
          <div class="generated-result" id="generated-result" aria-live="polite"></div>
          </details>
          <p class="stage-copy stage-copy--note"></p>
          <div class="room-actions">
            <button class="secondary-action" type="button" data-return-corridor>RETURN TO CORRIDOR</button>
            <button class="primary-action" type="button" data-continue="valueRoom" id="package-next" disabled>SEND TO VALUE ROOM</button>
          </div>
        </div>
      </section>

      <section class="room-scene room-scene--value" data-room="valueRoom" aria-labelledby="value-title" tabindex="-1">
        <div class="room-frame room-frame--wide">
          <p class="terminal-label">Valuation Room</p>
          <h2 id="value-title">Your Face Value</h2>
          <p class="stage-copy">Congratulations! Your face is worth a great deal.</p>
          <img class="valuation-ironwork valuation-ironwork--left" src="/assets/decor/valuation-ironwork.png" width="1584" height="480" alt="" aria-hidden="true" />
          <img class="valuation-ironwork valuation-ironwork--right" src="/assets/decor/valuation-ironwork.png" width="1584" height="480" alt="" aria-hidden="true" />
          <div class="valuation-report">
            <aside class="valuation-summary">
              <div class="valuation-portrait"><img data-value-portrait alt="Your selected portrait" hidden /><span data-value-portrait-empty aria-hidden="true">FX</span></div>
              <p>This round’s estimate</p>
              <div class="valuation-total"><b id="fvu-value">—</b><span>/ 100</span></div>
            </aside>
            <div class="value-grid" id="value-grid"></div>
          </div>
          <p class="valuation-buyer-note">A good price for your face can attract more buyers.</p>
          <div class="room-actions">
            <button class="secondary-action" type="button" data-return-corridor>RETURN TO CORRIDOR</button>
            <button class="primary-action" type="button" data-continue="termsRoom">GO TO THE AUCTION HALL</button>
          </div>
        </div>
      </section>

      <section class="room-scene room-scene--terms" data-room="termsRoom" aria-labelledby="terms-title" tabindex="-1">
        <div class="room-frame covenant-frame">
          <p class="terminal-label">Auction Hall</p><div class="official-seal" aria-hidden="true">FX<br/>SEAL</div>
          <h2 id="terms-title">AUTHORISATION OF LIKENESS</h2>
          <p class="stage-copy">Simulated licence terms. Continuing does not grant real rights.</p>
          <div class="covenant-list"><p><span>AI MODIFICATION</span><b>PERMITTED</b></p><p><span>COMMERCIAL REUSE</span><b>PERMITTED</b></p><p><span>DERIVATIVE LIKENESS</span><b>PERMITTED</b></p><p><span>THIRD-PARTY TRANSFER</span><b>PERMITTED</b></p><p><span>DURATION</span><b>INDEFINITE</b></p><p><span>WITHDRAWAL</span><b>RESTRICTED</b></p></div>
          <p class="microcopy">This fictional covenant is a prompt to consider how consent can be made to look routine.</p>
          <div class="room-actions"><button class="secondary-action" type="button" data-return-corridor>RETURN TO CORRIDOR</button><button class="primary-action" type="button" data-continue="auctionRoom">ACCEPT &amp; ENTER AUCTION</button></div>
        </div>
      </section>

      <section class="room-scene room-scene--auction" data-room="auctionRoom" aria-labelledby="auction-title" tabindex="-1">
        <div class="room-frame room-frame--wide">
          <p class="terminal-label">Honour</p><h2 id="auction-title">LOT 041 / HUMAN FACIAL LIKENESS</h2>
          <p class="stage-copy">The face is displayed as a relic. Agents bid on future uses rather than the person.</p>
          <div class="auction-grid" id="auction-grid">
            <article class="auction-card" data-agent="employer"><span>FVU AGENT A</span><strong>Employer Agent</strong><p>Bids for employability, authority and professional trust.</p><small>This face could perform well in a job market.</small><output id="bid-employer">0</output></article>
            <article class="auction-card" data-agent="platform"><span>FVU AGENT B</span><strong>Platform Agent</strong><p>Bids for attention, visibility and engagement.</p><small>This face could circulate well.</small><output id="bid-platform">0</output></article>
            <article class="auction-card" data-agent="advertiser"><span>FVU AGENT C</span><strong>Advertiser Agent</strong><p>Bids for trust, lifestyle signal and selling power.</p><small>This face could sell aspiration.</small><output id="bid-advertiser">0</output></article>
            <article class="auction-card" data-agent="verification"><span>FVU AGENT D</span><strong>Verification Agent</strong><p>Bids for access, compliance and identity control.</p><small>This face could become proof.</small><output id="bid-verification">0</output></article>
            <article class="auction-card" data-agent="collector"><span>FVU AGENT E</span><strong>Collector Agent</strong><p>Bids for rarity, resale potential and identity asset value.</p><small>This face could become collectible.</small><output id="bid-collector">0</output></article>
          </div>
          <p class="system-line" id="auction-message">BIDS WAITING FOR VALUE INPUT</p>
          <div class="room-actions">
            <button class="secondary-action" type="button" data-return-corridor>RETURN TO CORRIDOR</button>
            <button class="primary-action" type="button" data-continue="reflectRoom">CONTINUE TO REFLECTION</button>
          </div>
        </div>
      </section>

      <section class="room-scene room-scene--sold" data-room="soldRoom" aria-labelledby="sold-title" tabindex="-1"><div class="room-frame room-frame--wide sold-frame"><p class="terminal-label">Sale</p><h2 id="sold-title">SOLD</h2><p class="stage-copy">The portrait is no longer presented as a person. It is retained as an asset, lot and licence record.</p><div class="result-grid"><div class="scan-card result-preview-card relic-archive"><img id="result-preview" class="face-preview" alt="Submitted face in exchange result" hidden /><div class="scan-overlay" aria-hidden="true"></div><img class="sold-portrait-stamp" data-sold-stamp src="/assets/ui/sold-stamp-oxblood.png" alt="SOLD" width="1774" height="887" hidden /><p class="system-line">ARCHIVE STATUS: TRANSFERRED</p></div><div class="result-panel" id="result-panel"></div></div><div class="room-actions"><button class="secondary-action" type="button" data-return-corridor>RETURN TO CORRIDOR</button><button class="primary-action" type="button" data-continue="auctionRoom">VIEW THE FACE CASCADE</button></div></div></section>

      <section class="room-scene room-scene--afterlife" data-room="afterlifeRoom" aria-labelledby="afterlife-title" tabindex="-1"><div class="room-frame room-frame--wide"><p class="terminal-label">Afterlife</p><h2 id="afterlife-title">AFTER SALE: A LIKENESS CONTINUES</h2><p class="stage-copy">Once licensed, the face can acquire a digital life that no longer depends on its original owner.</p><div class="afterlife-chain" aria-label="Potential fictional chain of reuse"><span>ORIGINAL FACE</span><i>→</i><span>AI CHARACTER</span><i>→</i><span>ADVERTISEMENT</span><i>→</i><span>VIRTUAL INFLUENCER</span><i>→</i><span>GAME</span><i>→</i><span>RESALE</span><i>→</i><span>TRAINING DATA</span></div><p class="stage-copy stage-copy--question">The asset persists. Can the person still withdraw?</p><div class="room-actions"><button class="secondary-action" type="button" data-return-corridor>RETURN TO CORRIDOR</button><button class="primary-action" type="button" data-continue="reflectRoom">CONTINUE TO REFLECTION</button></div></div></section>

      <section class="room-scene room-scene--reflect" data-room="reflectRoom" aria-labelledby="reflection-title" tabindex="-1">
        <div class="room-frame room-frame--wide">
          <p class="terminal-label">Reflection</p>
          <h2 id="reflection-title">WHAT EXACTLY DID YOU SELL?</h2>
          <div class="reflection-response" aria-live="polite">
