---
const steps = [
  '01 INTRO',
  '02 SUBMIT',
  '03 CLASSIFY',
  '04 VALUE',
  '05 AUCTION',
  '06 COST',
  '07 REFLECT',
];
---

<nav class="progress-path" aria-label="Exchange path progress">
  {steps.map((step, index) => (
    <span class="progress-step" data-progress-step={index} aria-current={index === 0 ? 'step' : undefined}>
      {step}
    </span>
  ))}
</nav>
