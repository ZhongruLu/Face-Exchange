---
import '../styles/global.css';

const { title = 'Face Exchange' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A speculative interactive website about how digital interfaces turn a face into measurable, comparable and exchangeable value."
    />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/identity/face-exchange-icon.png" />
    <link rel="stylesheet" href="/assets/fonts/guidance.css" />
    <link rel="stylesheet" href="/assets/fonts/editorial.css" />
    <link rel="preload" href="/assets/fonts/bodoni-moda-roman.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/assets/fonts/newsreader-roman.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
